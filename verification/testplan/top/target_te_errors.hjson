{
  name: Target error detection
  testpoints:
  [
    {
      name: te0_errors
      desc:
        '''
        TE0 error: reserved broadcast address triggers HDR error mode and
        recovery. Randomly samples the eight reserved address patterns and
        recovery methods (HDR exit and timeout). Does not guarantee every
        pattern or both recovery methods are exercised in one invocation.
        '''
      tests: ["te0_errors"]
      tags: ["top"]
    }
    {
      name: te1_errors
      desc:
        '''
        TE1 error: CCC parity error triggers HDR error mode and recovery.
        Randomly samples broadcast CCCs with bad T-bit parity and recovery
        methods. Includes an explicit ENTHDR0/HDR-exit control; timeout
        recovery is not guaranteed in every invocation.
        '''
      tests: ["te1_errors"]
      tags: ["top"]
    }
    {
      name: ccc_error_private_descriptor
      desc:
        '''
        Live-global-error descriptor isolation: inject real CCC defining-byte
        TE2, TE1 command parity, or SETNEWDA padding/framing error, require
        exact source event/counter/status deltas and preserved address, then
        check the first valid private write's exact clean descriptor and data
        while global Protocol Error remains set. TE1 recovers using HDR exit.
        No GETSTATUS, reset, FIFO access or private operation occurs between
        the source error and the discriminating write. GETSTATUS clears the
        global error only after descriptor/data checks, with exact byte/EOD
        checks. Includes no-error and CCC TE2 DET_EN=0 controls.
        This differs from ccc_getstatus_complete_then_chain in test_ccc,
        which clears global status before its descriptor check.
        Private parity and overflow remain separate negative controls:
        te2_private_write_parity and i3c_target_pwrite_overflow_detection.
        '''
      tests: ["ccc_error_private_descriptor"]
      tags: ["top"]
    }
    {
      name: te2_private_write_parity
      desc:
        '''
        Injects bad T-bit parity on private write data and checks error
        registers plus an errored descriptor with zero length. Resets the RX
        data FIFO before recovery without first checking its emptiness, then
        consumes and checks a clean recovery descriptor and exact data.
        With detection disabled, the descriptor must report full length without error.
        Disabled detection also preserves exact data and leaves global
        Protocol Error clear.
        '''
      tests: ["te2_private_write_parity"]
      tags: ["top"]
    }
    {
      name: te_error_registers_sweep
      desc:
        '''
        Register infrastructure test: FORCE->STATUS, W1C, counter write/readback
        and clear, and ENABLE gating. Sequentially forces a randomly selected
        subset of error bits and checks accumulated status. No bus traffic or
        counter-saturation check is performed.
        '''
      tests: ["te_error_registers_sweep"]
      tags: ["top"]
    }
    {
      name: controller_abort_scenarios
      desc:
        '''
        Sends three to five random-length private writes, each completed with
        STOP, cleans up the RX FIFO, and checks GETSTATUS responsiveness.
        Finishes with another private write. Does not exercise private reads
        or inject an abort within the transmitted data.
        '''
      tests: ["controller_abort_scenarios"]
      tags: ["top"]
    }
    {
      name: te_error_sequence_mixing
      desc:
        '''
        Cross-coverage: inject TE0, TE1, TE2 in random order with recovery.
        Verifies that each error type is correctly detected and only the
        corresponding status/counter is updated.
        '''
      tests: ["te_error_sequence_mixing"]
      tags: ["top"]
    }
    {
      name: te_error_ri_isolation
      desc:
        '''
        Checks TTI private-write recovery after TE0 and TE2 errors.
        After TE0/HDR-exit recovery, requires a nonzero RX descriptor length.
        After TE2 cleanup and GETSTATUS, requires a clean descriptor with the
        subsequent write's expected length. No RI transfer or bidirectional
        RI-path isolation check is performed.
        '''
      tests: ["te_error_ri_isolation"]
      tags: ["top"]
    }
    {
      name: te_counter_per_event
      desc:
        '''
        Verifies TE0/TE1 error counters increment exactly once per single
        error event. TE0 fires once per corrupted address header. TE1 fires
        once per CCC byte with bad parity.
        '''
      tests: ["te_counter_per_event"]
      tags: ["top"]
    }
    {
      name: te0_during_ccc_repeated_start
      desc:
        '''
        Coverage: i3c_target_fsm.sv in_hdr_mode_i override from CheckSByte.
        Trigger TE0 from RxSByteRepeated state via S+7E/W -> ACK -> Sr -> 7E/R.
        FSM enters CheckSByte then transitions to InHDRMode via in_hdr_mode_i
        override. Recovers via HDR timeout.
        '''
      tests: ["te0_during_ccc_repeated_start"]
      tags: ["top"]
    }
    {
      name: ri_interrupt_force_all
      desc:
        '''
        Tests interrupt FORCE mechanism for all RI error interrupt instances.
        For each RI error type (readonly, unsupported, rx_fifo_overflow,
        indirect_fifo_overflow): disable interrupt and force (verify no effect),
        enable and force (verify status set and irq_o high), clear and verify
        irq_o low.
        '''
      tests: ["ri_interrupt_force_all"]
      tags: ["top"]
    }
    {
      name: ri_rx_fifo_overflow_irq
      desc:
        '''
        Verifies that RX FIFO overflow triggers the RI_RX_FIFO_OVERFLOW_ERR
        interrupt output (irq_o toggle 0->1->0) when both DET_EN and INTR_EN
        are enabled.
        '''
      tests: ["ri_rx_fifo_overflow_irq"]
      tags: ["top"]
    }
    {
      name: ri_indirect_fifo_overflow_irq
      desc:
        '''
        Verifies that INDIRECT FIFO overflow triggers the
        RI_INDIRECT_FIFO_OVERFLOW_ERR interrupt output (irq_o toggle 0->1->0)
        when both DET_EN and INTR_EN are enabled.
        '''
      tests: ["ri_indirect_fifo_overflow_irq"]
      tags: ["top"]
    }
  ]
}
