// FIXME: add detailed description of tests using testbench/stimulus/check template
{
  name: Controller Handle IBI
  testpoints:
  [
    {
      name: Controller Handle a target Interrupt Request
      desc:
        '''
        Recognize the IBI pattern as specified in 5.1.6.2 I3C Basic Spec, refuse or accept the interrupt. Write to the IBI queue
        '''
      tests: ["controller_target_interrupt_request"]
      tags: ["top"]
    }
    {
      name: Controller Active Controller Initiating a Transaction
      desc:
        '''
        As per 5.1.6.4 I3C Basic Spec issue the I3C broadcast address and wait for incoming IBI from targets. 
        '''
      tests: ["controller_controller_initiate_interrupt_request"]
      tags: ["top"]
    }
  ]
}
