{
  name: i3c_bus_monitor
  testpoints:
  [
    {
      name: bus_monitor_hdr_exit
      desc:
        '''
        Sends an HDR exit pattern in SDR and HDR modes at two starting
        phases away from sampling-clock edges. Requires zero exit events
        in SDR and exactly one rising exit event in HDR, checking both the
        pattern detector and combined output. Initializes timeout controls
        with timeout disabled and a nonzero threshold, rejects X/Z outputs,
        and verifies the timeout comparator did not supply the exit.
        '''
      tests: ["bus_monitor_hdr_exit"]
      tags: ["i3c_bus_monitor"]
    }
    {
      name: target_reset_detection
      desc:
        '''
        Issues a target reset pattern to the I3C bus, verifies that the
        i3c_bus_monitor correctly report it detected.
        '''
      tests: ["target_reset_detection"]
      tags: ["i3c_bus_monitor"]
    }
  ]
}